# Copy to .env and adjust. Never commit .env.

# --- Core ------------------------------------------------------------------
# The deterministic quantitative brain is the mandatory decision path, so the
# LLM layer is off unless deliberately turned on (spec §23, §35).
LLM_ENABLED=false

# live | paper | backtest | replay. Stays `paper` until a broker adapter
# exists — there is nothing for `live` to place an order through.
RUN_MODE=paper

# Refuses every order at the Execution Gate while true. Turn it on from
# anywhere, at any time, and mean it.
KILL_SWITCH_ENABLED=false

DATABASE_URL=postgresql+asyncpg://localhost:5432/index_option_brain
REDIS_URL=redis://localhost:6379/0

# --- Tailscale (docker compose only) ---------------------------------------
# An ephemeral, pre-authorized, TAGGED auth key from
# https://login.tailscale.com/admin/settings/keys
# Tagged so the node is owned by the tag and does not expire with your user.
TS_AUTHKEY=

# The MagicDNS name the console answers on:
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=index-brain
TS_TAGS=tag:index-brain

# --- Broker credentials ----------------------------------------------------
# None of these are read yet: no broker adapter is implemented. Listed so the
# shape is known before one is.
#
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
# DHAN_SANDBOX=true
